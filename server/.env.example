# ── runtime ───────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1
LOG_LEVEL=info

# ── database ──────────────────────────────────────────────────────────────
# Local replica set from docker-compose (transactions enabled):
MONGO_URI=mongodb://127.0.0.1:27017/saji?replicaSet=rs0&directConnection=true
# MongoDB Atlas (production):
# MONGO_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/saji?retryWrites=true&w=majority

# ── auth ──────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change-me-to-a-long-random-string
JWT_REFRESH_SECRET=change-me-to-a-different-long-random-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30
RATE_LIMIT_AUTH_MAX=5

# ── cors ──────────────────────────────────────────────────────────────────
# Comma separated. Use * only in development.
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# ── cloudinary (server-side only — never ship these to the app) ───────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── firebase cloud messaging (server-side only) ───────────────────────────
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ── feature flags ─────────────────────────────────────────────────────────
# SMS delivery in Algeria is unreliable and the admin phones every customer,
# so OTP ships built but disabled at v1.
OTP_ENABLED=false
LATE_SWEEPER_INTERVAL_MS=60000
